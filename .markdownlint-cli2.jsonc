{
  // markdownlint configuration for OpenVox documentation (voxdocs)
  "config": {
    // MD013: Line length -- disabled. Documentation has long code examples,
    // tables, and URLs that legitimately exceed 80 chars.
    "MD013": false,

    // MD024: Multiple headings with same content -- allowed with siblings_only.
    // Docs reuse headings like "Examples", "Parameters" across sections.
    "MD024": { "siblings_only": true },

    // MD033: Inline HTML -- disabled. Docs occasionally use HTML for
    // anchors, details/summary, and special formatting.
    "MD033": false,

    // MD060: Table column style -- disabled. Table pipe spacing is
    // cosmetic and the docs have extensive tables that are readable
    // as-is. Enforcing uniform spacing would churn hundreds of lines
    // with no readability benefit.
    "MD060": false
  }
}
